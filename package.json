{
  "name": "sulcore-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "metrics": "node scripts/metrics.mjs",
    "verify": "node scripts/verify-build.mjs",
    "lighthouse": "npx @lhci/cli@0.15.1 autorun",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run metrics && npm run build && npm run verify",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "geist": "^1.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "description": "Site institucional da SulCore — software sob medida, integrações e IA aplicada.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sulcore/sulcore.github.io.git"
  },
  "engines": {
    "node": ">=20.9",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2"
}
